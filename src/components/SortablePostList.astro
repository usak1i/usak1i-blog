---
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";

interface Props {
    /** 傳進來時應該已經是「最新在前」的順序；沒有 JS 時就照這個順序顯示 */
    posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

// 排序選項；key 會出現在網址 ?sort=<key>，第一個是預設
const SORTS = [
    { key: "newest", label: "最新" },
    { key: "oldest", label: "最舊" },
    { key: "updated", label: "最近更新" },
    { key: "title", label: "標題" },
];
---

<div class="sortable" data-sortable>
    {
        posts.length > 1 && (
            <div class="sort" hidden>
                <button
                    type="button"
                    class="sort-toggle"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-label={`排序：${SORTS[0].label}`}
                    title={`排序：${SORTS[0].label}`}
                >
                    {/* 上下箭頭 */}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M7 4v16M3 8l4-4 4 4M17 20V4M13 16l4 4 4-4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>

                <ul class="sort-menu card" role="menu" aria-label="排序方式" hidden>
                    {SORTS.map(({ key, label }, i) => (
                        <li role="none">
                            <button
                                type="button"
                                role="menuitemradio"
                                data-sort={key}
                                data-label={label}
                                aria-checked={i === 0 ? "true" : "false"}
                                tabindex="-1"
                            >
                                <span class="check" aria-hidden="true">✓</span>
                                {label}
                            </button>
                        </li>
                    ))}
                </ul>
            </div>
        )
    }

    <div class="posts" data-posts>
        {
            posts.map((post) => (
                <div
                    data-post
                    data-published={post.data.published.valueOf()}
                    data-updated={(post.data.updated ?? post.data.published).valueOf()}
                    data-title={post.data.title}
                >
                    <PostCard post={post} />
                </div>
            ))
        }
    </div>
</div>

<script>
    type Item = HTMLElement & { dataset: { published: string; updated: string; title: string } };

    const num = (el: Item, key: "published" | "updated") => Number(el.dataset[key]);
    const byNewest = (a: Item, b: Item) => num(b, "published") - num(a, "published");

    const compare: Record<string, (a: Item, b: Item) => number> = {
        newest: byNewest,
        oldest: (a, b) => -byNewest(a, b),
        updated: (a, b) => num(b, "updated") - num(a, "updated") || byNewest(a, b),
        // 用 "en" 規則：英文不分大小寫依字母排，中文排在英文後面；numeric 讓 "LC 2" 排在 "LC 10" 前面
        title: (a, b) =>
            a.dataset.title.localeCompare(b.dataset.title, "en", { numeric: true }) ||
            byNewest(a, b),
    };
    const DEFAULT = "newest";

    for (const root of document.querySelectorAll<HTMLElement>("[data-sortable]")) {
        const wrapper = root.querySelector<HTMLElement>(".sort");
        const toggle = root.querySelector<HTMLButtonElement>(".sort-toggle");
        const menu = root.querySelector<HTMLElement>(".sort-menu");
        const list = root.querySelector<HTMLElement>("[data-posts]");
        if (!wrapper || !toggle || !menu || !list) continue;

        const options = [...menu.querySelectorAll<HTMLButtonElement>("[data-sort]")];

        const apply = (key: string) => {
            const items = [...list.querySelectorAll<Item>(":scope > [data-post]")];
            items.sort(compare[key]);
            list.append(...items); // append 已存在的節點 = 移動，不會重建
            for (const o of options) o.setAttribute("aria-checked", String(o.dataset.sort === key));
            const label = options.find((o) => o.dataset.sort === key)?.dataset.label ?? "";
            toggle.setAttribute("aria-label", `排序：${label}`);
            toggle.title = `排序：${label}`;
            toggle.classList.toggle("is-custom", key !== DEFAULT);
        };

        const isOpen = () => !menu.hidden;
        const open = () => {
            menu.hidden = false;
            toggle.setAttribute("aria-expanded", "true");
            // 打開時把焦點放在目前選中的選項
            (options.find((o) => o.getAttribute("aria-checked") === "true") ?? options[0]).focus();
        };
        const close = (returnFocus = true) => {
            if (!isOpen()) return;
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            if (returnFocus) toggle.focus();
        };

        toggle.addEventListener("click", () => (isOpen() ? close() : open()));

        for (const option of options) {
            option.addEventListener("click", () => {
                const key = option.dataset.sort!;
                apply(key);
                const url = new URL(location.href);
                if (key === DEFAULT) url.searchParams.delete("sort");
                else url.searchParams.set("sort", key);
                history.replaceState(null, "", url);
                close();
            });
        }

        // 鍵盤：上下鍵移動、Home/End 跳到頭尾、Esc 關閉、Tab 離開時關閉
        menu.addEventListener("keydown", (e) => {
            const i = options.indexOf(document.activeElement as HTMLButtonElement);
            const move = (n: number) => options[(n + options.length) % options.length].focus();
            if (e.key === "ArrowDown") move(i + 1);
            else if (e.key === "ArrowUp") move(i - 1);
            else if (e.key === "Home") move(0);
            else if (e.key === "End") move(options.length - 1);
            else if (e.key === "Escape") close();
            else if (e.key === "Tab") return close(false);
            else return;
            e.preventDefault();
        });

        // 點選單外面就關閉
        document.addEventListener("click", (e) => {
            if (!wrapper.contains(e.target as Node)) close(false);
        });

        // 網址上的 ?sort= 決定初始排序，方便分享同一個排序結果
        const fromUrl = new URL(location.href).searchParams.get("sort");
        const initial = fromUrl && fromUrl in compare ? fromUrl : DEFAULT;
        if (initial !== DEFAULT) apply(initial);

        // 有 JS 才顯示排序按鈕
        wrapper.hidden = false;
    }
</script>

<style>
    .sortable,
    .posts {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .sort {
        position: relative;
        align-self: flex-end;
    }

    .sort[hidden],
    .sort-menu[hidden] {
        display: none;
    }

    .sort-toggle {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: none;
        border-radius: 0.6rem;
        background: var(--card-bg);
        color: var(--text-muted);
        cursor: pointer;
        transition:
            background-color 0.15s,
            color 0.15s;
    }

    .sort-toggle svg {
        width: 1.2rem;
        height: 1.2rem;
    }

    .sort-toggle:hover,
    .sort-toggle[aria-expanded="true"] {
        background: var(--primary-soft);
        color: var(--primary);
    }

    /* 不是預設排序時，icon 用主色提示「目前有套用排序」 */
    .sort-toggle.is-custom {
        color: var(--primary);
    }

    .sort-menu {
        position: absolute;
        top: calc(100% + 0.4rem);
        right: 0;
        z-index: 5;
        min-width: 9rem;
        margin: 0;
        padding: 0.35rem;
        list-style: none;
        /* 選單會疊在文章卡片上，兩者底色相同，用邊框分開 */
        border: 1px solid var(--border);
        box-shadow: 0 6px 24px oklch(0 0 0 / 0.12);
    }

    .sort-menu button {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        width: 100%;
        padding: 0.4rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background: none;
        color: var(--text);
        font: inherit;
        font-size: 0.9rem;
        text-align: left;
        cursor: pointer;
    }

    .sort-menu button:hover,
    .sort-menu button:focus-visible {
        background: var(--primary-soft);
        color: var(--primary);
        outline: none;
    }

    .sort-menu button[aria-checked="true"] {
        color: var(--primary);
        font-weight: 600;
    }

    .check {
        width: 1em;
        visibility: hidden;
    }

    .sort-menu button[aria-checked="true"] .check {
        visibility: visible;
    }

    .sort-toggle:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
</style>
