---
import type { CollectionEntry } from "astro:content";
import { categoryHref, categoryLabel, formatDate, tagHref } from "../utils/posts";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, published, category, tags } = post.data;
const href = `/blog/${post.id}/`;
---

<article class="card post-card">
    <h3 class="title"><a href={href}>{title}</a></h3>

    <div class="meta">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        <a class="category" href={categoryHref(category)}>
            {categoryLabel(category)}
        </a>
    </div>

    {description && <p class="description">{description}</p>}

    {
        tags.length > 0 && (
            <ul class="tags">
                {tags.map((tag) => (
                    <li>
                        <a href={tagHref(tag)}>#{tag}</a>
                    </li>
                ))}
            </ul>
        )
    }
</article>

<style>
    .post-card {
        position: relative;
        padding-left: 2rem;
    }

    /* 左側的主色短條 */
    .post-card::before {
        content: "";
        position: absolute;
        left: 1rem;
        top: 1.85rem;
        width: 0.25rem;
        height: 1.25rem;
        border-radius: 1rem;
        background: var(--primary);
    }

    .title {
        margin: 0;
        font-size: 1.35rem;
        line-height: 1.4;
    }

    .title a {
        color: var(--text);
    }

    .title a:hover {
        color: var(--primary);
        text-decoration: none;
    }

    /* 整張卡片都可以點 */
    .title a::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: var(--radius);
    }

    .post-card:has(a:focus-visible) {
        outline: 2px solid var(--primary);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    /* 疊在「整張卡片可點」的連結上面，才點得到分類 */
    .category {
        position: relative;
        z-index: 1;
        padding: 0 0.5rem;
        border-radius: 0.4rem;
        background: var(--primary-soft);
        color: var(--primary);
    }

    .category:hover {
        text-decoration: none;
        background: var(--primary);
        color: var(--card-bg);
    }

    .description {
        margin: 0.75rem 0 0;
        color: var(--text-muted);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        margin: 0.75rem 0 0;
        padding: 0;
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    /* tag 連結也要疊在「整張卡片可點」的連結上面 */
    .tags a {
        position: relative;
        z-index: 1;
        color: var(--text-muted);
    }

    .tags a:hover {
        color: var(--primary);
    }
</style>
