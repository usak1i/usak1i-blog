---
import type { IconName } from "../config";

interface Props {
    name: IconName;
    size?: string;
}

const { name, size = "1.25rem" } = Astro.props;

// icon 都是 24x24。要新增就在這裡加一筆，並把名字加進 config.ts 的 IconName。
// 線條 icon 放 paths；實心的品牌 logo（例如 Discord）放 filledPaths。
const paths: Partial<Record<IconName, string>> = {
