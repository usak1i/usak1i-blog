---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 Not Found" noindex>
    <section class="card not-found">
        <h1>404</h1>
        <p>This page doesn't exist :(</p>
        <p><a href="/">Back to Home</a></p>
    </section>
</Layout>

<style>
    .not-found {
        text-align: center;
    }

    h1 {
        font-size: 4rem;
        margin: 0;
        color: var(--primary);
    }
</style>
