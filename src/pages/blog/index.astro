---
import Layout from "../../layouts/Layout.astro";
import SortablePostList from "../../components/SortablePostList.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { getSortedPosts } from "../../utils/posts";

const posts = await getSortedPosts();
---

<Layout title="Blog" description="Blog posts by usak1i.">
    <section class="list">
        <h1 class="section-title">所有文章 <span>{posts.length}</span></h1>
        <CategoryNav />
        {
            posts.length > 0 ? (
                <SortablePostList posts={posts} />
            ) : (
                <p class="card">還沒有文章。</p>
            )
        }
    </section>
</Layout>

<style>
    .list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 50rem;
        margin-inline: auto;
    }

    .section-title {
        margin: 0;
        font-size: 1.5rem;
    }

    .section-title span {
        color: var(--text-muted);
        font-size: 1rem;
        font-weight: 400;
    }
</style>
