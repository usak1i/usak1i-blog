---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
    categoryHref,
    categoryLabel,
    formatDate,
    getSortedPosts,
    tagHref,
} from "../../utils/posts";

export async function getStaticPaths() {
    const posts = await getSortedPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, published, updated, category, tags } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description || undefined}>
    <article class="card post">
        <header>
            <h1>{title}</h1>
            <div class="meta">
                <time datetime={published.toISOString()}>{formatDate(published)}</time>
                {
                    updated && (
                        <span>
                            更新於 <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                        </span>
                    )
                }
                <a class="category" href={categoryHref(category)}>
                    {categoryLabel(category)}
                </a>
            </div>
            {
                tags.length > 0 && (
                    <ul class="tags">
                        {tags.map((tag) => (
                            <li>
                                <a href={tagHref(tag)}>#{tag}</a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </header>

        <div class="prose">
            <Content />
        </div>
    </article>
</Layout>

<style>
    .post {
        max-width: 64rem;
        margin-inline: auto;
        padding: 2rem;
    }

    h1 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.3;
    }

    .meta,
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.75rem;
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    .category {
        padding: 0 0.5rem;
        border-radius: 0.4rem;
        background: var(--primary-soft);
        color: var(--primary);
    }

    .tags {
        list-style: none;
        margin-bottom: 0;
        padding: 0;
    }

    header {
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px dashed var(--border);
    }

    @media (max-width: 30rem) {
        .post {
            padding: 1.25rem;
        }
    }
</style>
