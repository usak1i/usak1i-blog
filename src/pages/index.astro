---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import PostCard from "../components/PostCard.astro";
import { getSortedPosts } from "../utils/posts";
import { HOME_POST_COUNT } from "../config";

const posts = (await getSortedPosts()).slice(0, HOME_POST_COUNT);
---

<Layout>
    <div class="home">
        <ProfileCard />

        <section class="latest">
            <h2 class="section-title">最新文章</h2>
            {
                posts.length > 0 ? (
                    posts.map((post) => <PostCard post={post} />)
                ) : (
                    <p class="card empty">還沒有文章。</p>
                )
            }
            <a class="more" href="/blog/">查看全部文章 →</a>
        </section>
    </div>
</Layout>

<style>
    .home {
        display: grid;
        grid-template-columns: 17.5rem minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }

    /* 桌機時資料卡跟著捲動停在導覽列下方 */
    .home > :global(.profile) {
        position: sticky;
        top: 5rem;
    }

    .latest {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section-title {
        margin: 0;
        font-size: 1.1rem;
        color: var(--text-muted);
    }

    .empty {
        margin: 0;
        color: var(--text-muted);
    }

    .more {
        align-self: flex-end;
        font-weight: 500;
    }

    @media (max-width: 48rem) {
        .home {
            grid-template-columns: minmax(0, 1fr);
        }

        .home > :global(.profile) {
            position: static;
        }
    }
</style>
