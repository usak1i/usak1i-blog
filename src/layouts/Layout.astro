---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    /** 頁面標題，會顯示成「標題 | usak1i」；不給就用網站名稱 */
    title?: string;
    /** 給搜尋引擎和社群分享預覽用的描述 */
    description?: string;
    /** 不讓搜尋引擎收錄（例如 404 頁） */
    noindex?: boolean;
}

const SITE_TITLE = "usak1i's Blog";
const SITE_DESCRIPTION = "CTF writeups and cybersecurity research by usak1i.";

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | usak1i` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        {
            noindex ? (
                <meta name="robots" content="noindex" />
            ) : (
                <link rel="canonical" href={canonical} />
            )
        }

        <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
        <link rel="icon" href="/favicon.ico" sizes="48x48 96x96" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />

        <!-- 在畫面出現前就套用主題，避免深色模式閃一下白 -->
        <script is:inline>
            (() => {
                let theme;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}
                if (theme !== "light" && theme !== "dark") {
                    theme = matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light";
                }
                document.documentElement.dataset.theme = theme;
            })();
        </script>
    </head>
    <body>
        <Navbar />
        <main class="container">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        flex: 1;
        padding-top: 1.5rem;
    }
</style>
